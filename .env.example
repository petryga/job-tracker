# Base URL of the job-tracker-api backend. Only used in production builds;
# `npm run dev` always talks to http://localhost:3000 (see src/api/apiSlice.ts).
VITE_BACKEND_URL=

# Supabase project auth. Both must be set for login to be enabled; leave both
# blank to run the app in its no-auth mode (RequireAuth passes through and the
# API is expected to run with AUTH_DISABLED=true). Use the SAME Supabase project
# as the backend's SUPABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
